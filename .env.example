# Copy this file to .env and fill in your values
# NEVER commit your real .env file to git

# Binance API credentials
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Exchange settings
EXCHANGE_ID=binance
TESTNET=true          # Set to false for real trading (CAUTION)

# Trading pairs (comma-separated for multi-pair) and timeframe
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=5m          # 1m, 5m, 15m, 1h

# Strategy parameters
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_OVERSOLD=40
RSI_OVERBOUGHT=70

# Risk management
RISK_PER_TRADE=0.01   # 1% of balance per trade
TAKE_PROFIT_PCT=0.006 # 0.6%
STOP_LOSS_PCT=0.003   # 0.3%

# Trailing stop — locks in profit as price moves up
TRAILING_STOP_ENABLED=true
TRAILING_ACTIVATE_PCT=0.003  # arms after price moves +0.3% above entry
TRAILING_DISTANCE_PCT=0.002  # SL trails 0.2% behind the peak

# Bot loop interval in seconds
LOOP_SLEEP=30

# Google Gemini — PRIMARY provider (get free key at aistudio.google.com)
# Free tier: 1,500 req/day, 1M tokens/day — no credit card needed
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq AI — FALLBACK when Gemini fails (get free key at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant   # 500K tokens/day free
AI_CONFIDENCE_THRESHOLD=LOW        # LOW | MEDIUM | HIGH

# Active AI monitoring while in a position
AI_HOLD_CHECK_INTERVAL=300   # consult AI every 5 min while in a trade
AI_HOLD_PRICE_MOVE=0.003     # also trigger if price moves 0.3% (whichever comes first)

# Re-entry protection — avoids FOMO re-buys near the last exit price
RE_ENTRY_COOLDOWN=300        # hard 5-min pause after any close before new entry
RE_ENTRY_PRICE_BUFFER=0.003  # block re-entry if price > last exit price +0.3%
RE_ENTRY_AI_WINDOW=1800      # inject "recent exit" warning in AI prompt for 30 min

# Volume filter — skip signals with no volume confirmation
VOLUME_FILTER_ENABLED=true
VOLUME_FILTER_PERIODS=20     # compare last candle vs avg of previous 20
VOLUME_FILTER_MULT=1.0       # must be >= 1x the average

# VWAP filter — only BUY above the session VWAP
VWAP_FILTER_ENABLED=true

# Trading hours blackout (UTC) — avoid low-liquidity windows
TRADING_BLACKOUT_ENABLED=true
BLACKOUT_START=23            # 23:00 UTC
BLACKOUT_END=2               # 02:00 UTC

# Fear & Greed index (alternative.me — free, no key needed)
FEAR_GREED_ENABLED=true
FEAR_GREED_MIN=20            # block BUY in Extreme Fear
FEAR_GREED_MAX=80            # block BUY in Extreme Greed
FEAR_GREED_TTL=300           # re-fetch every 5 min

# Slippage warning
SLIPPAGE_WARN_PCT=0.001      # log warning if fill > 0.1% from signal price

# Max simultaneous open positions
MAX_OPEN_TRADES=2

# Macro sentiment check (AI overview of all pairs once per hour)
MACRO_CHECK_INTERVAL=3600

# Web dashboard (open http://localhost:5000 once the bot is running)
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# Telegram notifications
# Setup: message @BotFather on Telegram → /newbot → copy token
# Get chat ID: message @userinfobot → copy the id number
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=987654321
