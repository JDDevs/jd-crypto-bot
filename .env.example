# Copy this file to .env and fill in your values
# NEVER commit your real .env file to git

# Binance API credentials
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Exchange settings
EXCHANGE_ID=binance
TESTNET=true          # Set to false for real trading (CAUTION)

# Trading pair and timeframe
SYMBOL=BTC/USDT
TIMEFRAME=5m          # 1m, 5m, 15m, 1h

# Strategy parameters
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_OVERSOLD=40
RSI_OVERBOUGHT=70

# Risk management
RISK_PER_TRADE=0.01   # 1% of balance per trade
TAKE_PROFIT_PCT=0.006 # 0.6%
STOP_LOSS_PCT=0.003   # 0.3%

# Bot loop interval in seconds
LOOP_SLEEP=30

# Groq AI (get your free key at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
AI_CONFIDENCE_THRESHOLD=MEDIUM  # LOW | MEDIUM | HIGH — minimum confidence to act
