# Copy this file to .env and fill in your values
# NEVER commit your real .env file to git

# Binance API credentials
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Exchange settings
EXCHANGE_ID=binance
TESTNET=true          # Set to false for real trading (CAUTION)

# Trading pairs (comma-separated for multi-pair) and timeframe
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=5m          # 1m, 5m, 15m, 1h

# Strategy parameters
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_OVERSOLD=40
RSI_OVERBOUGHT=70

# Risk management
RISK_PER_TRADE=0.01   # 1% of balance per trade
TAKE_PROFIT_PCT=0.006 # 0.6%
STOP_LOSS_PCT=0.003   # 0.3%

# Trailing stop — locks in profit as price moves up
TRAILING_STOP_ENABLED=true
TRAILING_ACTIVATE_PCT=0.003  # arms after price moves +0.3% above entry
TRAILING_DISTANCE_PCT=0.002  # SL trails 0.2% behind the peak

# Bot loop interval in seconds
LOOP_SLEEP=30

# Google Gemini — PRIMARY provider (get free key at aistudio.google.com)
# Free tier: 1,500 req/day, 1M tokens/day — no credit card needed
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq AI — FALLBACK when Gemini fails (get free key at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant   # 500K tokens/day free
AI_CONFIDENCE_THRESHOLD=LOW        # LOW | MEDIUM | HIGH

# Active AI monitoring while in a position
AI_HOLD_CHECK_INTERVAL=180   # consult AI every 3 min while in a trade
AI_HOLD_PRICE_MOVE=0.001     # also trigger if price moves 0.1% (whichever comes first)

# Web dashboard (open http://localhost:5000 once the bot is running)
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# Telegram notifications
# Setup: message @BotFather on Telegram → /newbot → copy token
# Get chat ID: message @userinfobot → copy the id number
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=987654321
